FROM wordpress:7.0.2

# Tăng giới hạn dung lượng upload file của PHP lên 50MB (để CF7 không bị lỗi giới hạn 2MB)
RUN echo "file_uploads = On\n" \
    "memory_limit = 256M\n" \
    "upload_max_filesize = 50M\n" \
    "post_max_size = 50M\n" \
    "max_execution_time = 600\n" \
    > /usr/local/etc/php/conf.d/uploads.ini

# Copy plugin viettri-translation-editor vào bộ cài WordPress
COPY ./wordpress-plugins/viettri-translation-editor /usr/src/wordpress/wp-content/plugins/viettri-translation-editor

# Copy script wrapper để tự động đồng bộ plugin vào volume và phân quyền www-data
COPY ./docker-entrypoint-wrapper.sh /usr/local/bin/docker-entrypoint-wrapper.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-wrapper.sh

ENTRYPOINT ["docker-entrypoint-wrapper.sh"]
CMD ["apache2-foreground"]
